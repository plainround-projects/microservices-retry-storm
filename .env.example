# Copied to .env by `make up` the first time. These are throwaway values for a database that lives only on this
# machine. Change them if you share the machine. Nothing here is a real credential.
COMPOSE_PROJECT_NAME=storm

# Host ports (everything is bound to 127.0.0.1 only).
GATEWAY_PORT=43080
SEARCH_PORT=43081
PRICING_PORT=43082
STOCK_PORT=43083
STOCK_DB_PORT=43432

STOCK_OWNER_PASSWORD=local-owner-change-me
STOCK_APP_PASSWORD=local-app-change-me

# The stock store's capacity (requests it works on at once) and the faults it starts with. The experiments change the
# faults at runtime through its admin route; these are only the starting values.
STOCK_CONCURRENCY=16
LATENCY_MS=50
FAIL_RATE=0

# Search sheds load beyond this many requests in progress (the full profile only).
SEARCH_CONCURRENCY_LIMIT=40

# Share of gateway requests whose trace is recorded (traces for the experiments are forced on demand instead).
TRACE_SAMPLE_RATE=0

LOG_LEVEL=WARNING
